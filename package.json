{
  "name": "gowa-manager",
  "version": "2.3.1",
  "workspaces": [
    "client"
  ],
  "scripts": {
    "build:client": "cd client && bun run build",
    "build:go": "bun run scripts/build-go.ts",
    "build:production": "bun run build:client && bun run build:go",
    "dev": "cd client && bun run dev",
    "dev:go": "go run ./cmd/gowa-manager-go",
    "test:go": "go test ./... -count=1 -p=1",
    "test:benchmark:compare": "bun run test/benchmark/compare.ts",
    "test:e2e:go": "bun run build:client && bun run build:go && playwright test --config playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/bun": "latest",
    "typescript": "^5.9.2"
  }
}
